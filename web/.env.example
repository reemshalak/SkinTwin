# Copy to .env.local and fill in. Never commit real values.

# Supabase (accounts and community). Use the publishable/anon key, never the secret one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouCam API key (server-only). Live calls also need SKIN_MODE=live and the
# "YouCam live" switch on in Settings; otherwise the app uses demo results.
YOUCAM_API_KEY=
SKIN_MODE=live

# Daily caps on live YouCam calls (protects your units).
YOUCAM_DAILY_SCANS=25
YOUCAM_DAILY_SIMS=15
YOUCAM_DAILY_MAKEUP=20
